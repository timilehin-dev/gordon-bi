{
  "name": "gordon-analytics-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Source, Agent-First, Autonomous Business Analytics Desktop Platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test --loader tsx tests/integration/*.test.ts packages/*/tests/*.test.ts",
    "test:m0": "node --test --import tsx tests/integration/m0_foundation.test.ts",
    "test:m1": "node --test --import tsx tests/integration/m1_agent_runtime.test.ts",
    "test:all": "node --test --import tsx packages/**/tests/*.test.ts tests/integration/*.test.ts",
    "lint": "tsc --noEmit",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "duckdb": "^1.4.4"
  }
}
