yarn-error.log*
lerna-debug.log*

# Build outputs & caches
dist/
build/
target/
src-tauri/target/
.turbo/
.tsbuildinfo

# Compiled JavaScript and TypeScript declarations from packages
packages/**/*.js
packages/**/*.d.ts
packages/**/*.d.ts.map
packages/**/*.js.map
apps/**/dist/
apps/**/*.d.ts
apps/**/*.d.ts.map
apps/**/*.js.map
!apps/desktop-ui/build.js
!src-tauri/generate_icons.js

